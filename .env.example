# Mutation Domino configuration (all optional; defaults shown)
MUTATION_DOMINO_MODE=live
MUTATION_DOMINO_DATABASE_URL=sqlite:///backend/data/mutation_domino.db
MUTATION_DOMINO_CACHE_DIR=backend/data/cache
MUTATION_DOMINO_MAX_STRUCTURE_BYTES=31457280
MUTATION_DOMINO_UNIPROT_BASE_URL=https://rest.uniprot.org
MUTATION_DOMINO_ALPHAFOLD_BASE_URL=https://alphafold.ebi.ac.uk
MUTATION_DOMINO_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MUTATION_DOMINO_CONNECT_TIMEOUT_SECONDS=8
MUTATION_DOMINO_READ_TIMEOUT_SECONDS=45